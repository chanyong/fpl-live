NEXT_PUBLIC_APP_URL=http://localhost:3000
FPL_BASE_URL=https://fantasy.premierleague.com/api

# Upstream FPL request tuning (optional — defaults shown)
FPL_TIMEOUT_MS=10000
FPL_MAX_ATTEMPTS=3
FPL_PICKS_CONCURRENCY=8

# Weekly review journal (issue #21) - names only; set real values in Railway, never commit them
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JOURNAL_CRON_SECRET=

# AI recommendation layer (issue #43) - names only. The layer is OFF unless BOTH are set (and the Supabase names above):
# ANTHROPIC_API_KEY is entered by the owner in Railway; AI_RECOMMEND_ENABLED must be exactly "true". Remove either to switch it off.
ANTHROPIC_API_KEY=
AI_RECOMMEND_ENABLED=
